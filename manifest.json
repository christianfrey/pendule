{
"update_url":"http://clients2.google.com/service/update2/crx",
  "name": "Pendule",
  "version": "1.0.0",
  "description": "Web developer tools for Chrome.",
  "icons": {
    "16": "img/icon16.png",
    "48": "img/icon48.png",
    "128": "img/icon128.png"
  },
  "browser_action": {
    "default_icon": "img/icon19.png",
    "default_title": "Pendule",
    "popup": "popup/popup.html"
  },
  "background_page": "background.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_script_top_frame.js"]
    }
  ],
  "options_page": "options/options.html",
  "permissions": [
    "tabs",
    "cookies",
    "http://*/*",
    "https://*/*",
    "contextMenus"
  ]
}